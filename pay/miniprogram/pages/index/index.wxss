.page { padding: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; margin: 24rpx 0 12rpx; }
.sub { color: #6b7280; font-size: 26rpx; line-height: 1.6; margin-bottom: 32rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 32rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
.label { color: #6b7280; font-size: 26rpx; margin-bottom: 12rpx; }
.input { border: 1rpx solid #e5e7eb; border-radius: 12rpx; padding: 20rpx; font-size: 32rpx; margin-bottom: 16rpx; }
.price { font-size: 32rpx; font-weight: 700; color: #111827; }
.buy { background: #07c160; color: #fff; border-radius: 12rpx; font-size: 32rpx; margin-top: 8rpx; }
.hint { color: #9ca3af; font-size: 24rpx; margin-top: 24rpx; line-height: 1.6; }

.pkg-title { font-size: 28rpx; color: #6b7280; margin: 8rpx 0 16rpx; }
.pkg { display: flex; align-items: center; justify-content: space-between; background: #fff; border: 2rpx solid #e5e7eb; border-radius: 16rpx; padding: 28rpx 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.pkg-on { border-color: #07c160; background: #f0fbf4; }
.pkg-main { display: flex; flex-direction: column; }
.pkg-name { font-size: 34rpx; font-weight: 700; color: #111827; }
.pkg-count { font-size: 26rpx; color: #6b7280; margin-top: 6rpx; }
.pkg-side { text-align: right; }
.pkg-price { font-size: 38rpx; font-weight: 700; color: #07c160; }
.pkg-limit { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; }
