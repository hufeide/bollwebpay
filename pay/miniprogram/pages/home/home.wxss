.page { padding: 40rpx 36rpx; }
.logo { font-size: 88rpx; text-align: center; margin-top: 16rpx; }
.title { font-size: 42rpx; font-weight: 700; text-align: center; margin-top: 8rpx; }
.sub { color: #6b7280; font-size: 25rpx; line-height: 1.6; margin: 16rpx 0 28rpx; text-align: center; }

.preview { background: #f8fafc; border: 1rpx solid #e5e7eb; border-radius: 20rpx; overflow: hidden; margin-bottom: 32rpx; }
.prev-bar { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 24rpx; background: #111827; color: #fff; font-size: 26rpx; }
.prev-body { padding: 24rpx; min-height: 220rpx; }
.bubble { max-width: 78%; padding: 16rpx 20rpx; border-radius: 16rpx; font-size: 25rpx; margin-bottom: 16rpx; word-break: break-all; }
.bubble.them { background: #fff; color: #111827; border: 1rpx solid #e5e7eb; }
.bubble.me { background: #2563eb; color: #fff; margin-left: auto; }
.prev-input { padding: 18rpx 24rpx; background: #fff; border-top: 1rpx solid #e5e7eb; color: #9ca3af; font-size: 24rpx; }

.primary { background: #2563eb; color: #fff; border-radius: 16rpx; font-size: 32rpx; margin-bottom: 18rpx; }
.secondary { background: #fff; color: #374151; border: 1rpx solid #d1d5db; border-radius: 16rpx; font-size: 30rpx; margin-bottom: 18rpx; }
.link { background: #f3f4f6; color: #374151; border-radius: 16rpx; font-size: 28rpx; }
.hint { margin-top: 28rpx; color: #9ca3af; font-size: 22rpx; line-height: 1.6; }
